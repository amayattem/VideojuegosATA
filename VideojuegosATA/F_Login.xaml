<Window x:Class="VideojuegosATA.F_Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inicio de Sesión - VideojuegosATA" 
        Height="420" 
        Width="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <!-- Fondo degradado idéntico a MainWindow -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0.0"/>
            <GradientStop Color="#080D1A" Offset="0.5"/>
            <GradientStop Color="#020617" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Border Margin="20" Background="#111827" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Título -->
            <TextBlock Grid.Row="0" 
                       Text="Acceso a la Plataforma" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="#F8FAFC" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

            <!-- Usuario -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <Label Content="Usuario" Foreground="#CBD5E1" FontWeight="SemiBold" Padding="0,0,0,4"/>
                <TextBox x:Name="txtUsuario" 
                         Height="36" 
                         FontSize="14" 
                         Background="#1E293B" 
                         Foreground="White" 
                         BorderBrush="#334155"
                         VerticalContentAlignment="Center" 
                         Padding="8,0" 
                         TextChanged="txtUsuario_TextChanged"/>
            </StackPanel>

            <!-- Contraseña -->
            <StackPanel Grid.Row="2" Margin="0,0,0,10">
                <Label Content="Contraseña" Foreground="#CBD5E1" FontWeight="SemiBold" Padding="0,0,0,4"/>
                <PasswordBox x:Name="txtPassword" 
                             Height="36" 
                             FontSize="14" 
                             Background="#1E293B" 
                             Foreground="White" 
                             BorderBrush="#334155"
                             VerticalContentAlignment="Center" 
                             Padding="8,0"
                             PasswordChanged="txtPassword_PasswordChanged"/>
            </StackPanel>

            <!-- Mensaje dinámico -->
            <Label x:Name="lblMensaje" 
                   Grid.Row="3" 
                   Content="" 
                   HorizontalAlignment="Center" 
                   FontSize="12" 
                   Foreground="Red"
                   FontWeight="Medium" 
                   Height="25"/>

            <!-- Botones de Acción -->
            <Grid Grid.Row="4" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnLogin" 
                        Grid.Column="0" 
                        Content="Entrar" 
                        Height="38" 
                        Background="#2563EB" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        Click="btnLogin_Click" 
                        Cursor="Hand"/>

                <Button x:Name="btnSalir" 
                        Grid.Column="2" 
                        Content="Salir" 
                        Height="38" 
                        Background="#DC2626" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        Click="btnSalir_Click" 
                        Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>