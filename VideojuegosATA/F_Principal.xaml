<Window x:Class="VideojuegosATA.F_Principal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenido - VideojuegosATA" 
        Height="380" 
        Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <!-- Fondo en degradado azul oscuro idéntico a MainWindow -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0.0"/>
            <GradientStop Color="#080D1A" Offset="0.5"/>
            <GradientStop Color="#020617" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Border Margin="20" Background="#111827" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Padding="25">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Encabezado y mensaje de bienvenida -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,5,0,15">
                <TextBlock Text="¡Inicio de Sesión Exitoso!" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#38BDF8" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,8"/>

                <TextBlock x:Name="lblBienvenida" 
                           Text="¡Bienvenido/a a la plataforma!" 
                           FontSize="15" 
                           FontWeight="SemiBold" 
                           Foreground="#F8FAFC" 
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Mensaje informativo -->
            <Border Grid.Row="1" 
                    Background="#0F172A" 
                    CornerRadius="10" 
                    BorderBrush="#1E293B" 
                    BorderThickness="1" 
                    Padding="15" 
                    Margin="0,0,0,20" 
                    VerticalAlignment="Center">
                <TextBlock Text="Has ingresado correctamente a tu cuenta. Haz clic en 'Ir al Catálogo' para ver los juegos disponibles o cierra sesión para salir." 
                           FontSize="13" 
                           Foreground="#94A3B8" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center"/>
            </Border>

            <!-- Botones de Acción (Navegación + Cerrar Sesión) -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Botón Principal: Ir al Catálogo (Columna 0) -->
                <Button x:Name="btnIrCatalogo" 
                        Grid.Column="0" 
                        Content="🎮 Ir al Catálogo" 
                        Height="38" 
                        Background="#2563EB" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        Click="btnIrCatalogo_Click" 
                        Cursor="Hand"/>

                <!-- Botón Secundario: Cerrar Sesión (Columna 2) -->
                <Button x:Name="btnCerrarSesion" 
                        Grid.Column="2" 
                        Content="Cerrar Sesión" 
                        Height="38" 
                        Background="#DC2626" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        Click="btnCerrarSesion_Click" 
                        Cursor="Hand"/>
            </Grid>
        </Grid>
    </Border>
</Window>