<Window x:Class="VideojuegosATA.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blizzard Games - Inicio de Sesión" 
        Height="480" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <!-- FONDO EN DEGRADADO AZUL OSCURO -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0.0"/>
            <GradientStop Color="#080D1A" Offset="0.5"/>
            <GradientStop Color="#020617" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Border Margin="25" Padding="20" Background="#111827" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Encabezado -->
                <RowDefinition Height="Auto"/>
                <!-- Campos de texto -->
                <RowDefinition Height="50"/>
                <!-- Área de mensaje fija para evitar deformación -->
                <RowDefinition Height="Auto"/>
                <!-- Botones -->
            </Grid.RowDefinitions>

            <!-- ENCABEZADO -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock Text="BLIZZARD GAMES" Foreground="#38BDF8" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Iniciar Sesión" Foreground="#CBD5E1" FontSize="14" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- FORMULARIO (USUARIO Y CONTRASEÑA) -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="Usuario:" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUsuario" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155" Padding="8,6" FontSize="13" Margin="0,0,0,12"/>

                <TextBlock Text="Contraseña:" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtPassword" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155" Padding="8,6" FontSize="13"/>
            </StackPanel>

            <!-- MENSAJE DINÁMICO (ERROR / ÉXITO) -->
            <Grid Grid.Row="2" VerticalAlignment="Center">
                <TextBlock x:Name="lblMensaje" 
                           Text="" 
                           Foreground="#EF4444" 
                           FontSize="11" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Center" 
                           TextAlignment="Center" 
                           TextWrapping="Wrap" 
                           Visibility="Collapsed"/>
            </Grid>

            <!-- BOTONES CON TAMAÑO FIJO -->
            <StackPanel Grid.Row="3" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,5,0,0">
                <Button x:Name="btnLogin" 
                        Content="Login" 
                        Click="BtnLogin_Click" 
                        Width="200" 
                        Height="38" 
                        Background="#2563EB" 
                        Foreground="White" 
                        FontWeight="Bold" 
                        Margin="0,0,0,10" 
                        BorderThickness="0" 
                        Cursor="Hand"/>

                <Button x:Name="btnSalir" 
                        Content="Salir" 
                        Click="BtnSalir_Click" 
                        Width="200" 
                        Height="35" 
                        Background="#334155" 
                        Foreground="#E2E8F0" 
                        FontWeight="SemiBold" 
                        BorderThickness="0" 
                        Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>