<Window x:Class="VideojuegosATA.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blizzard Games - Inicio de Sesión" 
        Height="450" Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <!-- FONDO EN DEGRADADO AZUL OSCURO -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0.0"/>
            <GradientStop Color="#080D1A" Offset="0.5"/>
            <GradientStop Color="#020617" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Border Margin="30" Padding="25" Background="#111827" CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1">
        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="BLIZZARD GAMES" Foreground="#38BDF8" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="Iniciar Sesión" Foreground="#CBD5E1" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,25"/>

            <!-- CAMPO USUARIO -->
            <TextBlock Text="Usuario:" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsuario" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155" Padding="8,6" FontSize="13" Margin="0,0,0,15"/>

            <!-- CAMPO CONTRASEÑA -->
            <TextBlock Text="Contraseña:" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Background="#1E293B" Foreground="#FFFFFF" BorderBrush="#334155" Padding="8,6" FontSize="13" Margin="0,0,0,15"/>

            <!-- MENSAJE DINÁMICO (ERROR / ÉXITO) -->
            <TextBlock x:Name="lblMensaje" Text="" Foreground="#EF4444" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,15" Visibility="Collapsed"/>

            <!-- BOTONES -->
            <Button x:Name="btnLogin" Content="Login" Click="BtnLogin_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" Padding="10,8" Margin="0,5" BorderThickness="0" Cursor="Hand"/>
            <Button x:Name="btnSalir" Content="Salir" Click="BtnSalir_Click" Background="#334155" Foreground="#E2E8F0" FontWeight="SemiBold" Padding="10,6" Margin="0,5" BorderThickness="0" Cursor="Hand"/>

        </StackPanel>
    </Border>
</Window>