<Window x:Class="VideojuegosATA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Blizzard Games - Plataforma de Videojuegos" 
        Height="700" 
        Width="1040"
        WindowStartupLocation="CenterScreen">

    <!-- 1. FONDO EN DEGRADADO AZUL OSCURO -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0.0"/>
            <GradientStop Color="#080D1A" Offset="0.5"/>
            <GradientStop Color="#020617" Offset="1.0"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- Estilo para los botones del menú superior -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Estilo para los botones del menú lateral -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 2. BARRA SUPERIOR -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Menú central -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Column="0">
                <Button Content="TIENDA" Style="{StaticResource NavButton}" Foreground="#38BDF8"/>
                <Button Content="COMUNIDAD" Style="{StaticResource NavButton}"/>
                <Button Content="SOPORTE" Style="{StaticResource NavButton}"/>
            </StackPanel>

            <!-- Perfil con Avatar y Botón de Cerrar Sesión -->
            <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Cursor="Hand" Margin="0,0,15,0">
                    <Border Width="36" Height="36" CornerRadius="18" BorderBrush="#38BDF8" BorderThickness="1.5" Margin="0,0,10,0">
                        <Border.Background>
                            <ImageBrush ImageSource="/Images/perfil.jpg" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <TextBlock x:Name="lblNombreUsuario" Text="Mi Perfil" Foreground="#E2E8F0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13"/>
                </StackPanel>

                <!-- BOTÓN CERRAR SESIÓN -->
                <Button Content="Cerrar Sesión" Click="BtnCerrarSesion_Click" Background="#EF4444" Foreground="White" Padding="8,4" FontWeight="SemiBold" FontSize="11" BorderThickness="0" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- 3. CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PANEL LATERAL -->
            <Border Grid.Column="0" Background="#111827" CornerRadius="16" Padding="15" Margin="0,0,20,0" BorderBrush="#1E293B" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <Button Content="⭐ Destacados" Style="{StaticResource SidebarButton}" Background="#2563EB" Foreground="White"/>
                    <Button Content="🎮 Mis juegos" Style="{StaticResource SidebarButton}"/>
                    <Button Content="⚙️ Configuración" Style="{StaticResource SidebarButton}"/>
                </StackPanel>
            </Border>

            <!-- CATÁLOGO DE JUEGOS -->
            <Border Grid.Column="1" Background="#111827" CornerRadius="16" Padding="20" BorderBrush="#1E293B" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Juegos Recomendados" Foreground="#F8FAFC" FontSize="18" FontWeight="Bold" Margin="10,0,0,15"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel HorizontalAlignment="Center">

                            <!-- JUEGO 1: Clash Royale -->
                            <Border Width="160" Height="220" Margin="10" Background="#0F172A" CornerRadius="12" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="50"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0" Source="/Images/clashRoyale.jpg" Stretch="UniformToFill"/>
                                    <Border Grid.Row="1" Background="#1E293B" Padding="8,4">
                                        <TextBlock Text="Clash Royale" Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- JUEGO 2: Clash of Clans -->
                            <Border Width="160" Height="220" Margin="10" Background="#0F172A" CornerRadius="12" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="50"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0" Source="/Images/clashClans.jpg" Stretch="UniformToFill"/>
                                    <Border Grid.Row="1" Background="#1E293B" Padding="8,4">
                                        <TextBlock Text="Clash Of Clans" Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- JUEGO 3: Minecraft -->
                            <Border Width="160" Height="220" Margin="10" Background="#0F172A" CornerRadius="12" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="50"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0" Source="/Images/minecraft.jpg" Stretch="UniformToFill"/>
                                    <Border Grid.Row="1" Background="#1E293B" Padding="8,4">
                                        <TextBlock Text="Minecraft" Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- JUEGO 4: Fortnite -->
                            <Border Width="160" Height="220" Margin="10" Background="#0F172A" CornerRadius="12" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="50"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0" Source="/Images/fortnite.jpg" Stretch="UniformToFill"/>
                                    <Border Grid.Row="1" Background="#1E293B" Padding="8,4">
                                        <TextBlock Text="Fortnite" Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- JUEGO 5: Brawl Stars -->
                            <Border Width="160" Height="220" Margin="10" Background="#0F172A" CornerRadius="12" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="50"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0" Source="/Images/brawlStars.jpg" Stretch="UniformToFill"/>
                                    <Border Grid.Row="1" Background="#1E293B" Padding="8,4">
                                        <TextBlock Text="Brawl Stars" Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- JUEGO 6: Roblox -->
                            <Border Width="160" Height="220" Margin="10" Background="#0F172A" CornerRadius="12" ClipToBounds="True">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="50"/>
                                    </Grid.RowDefinitions>
                                    <Image Grid.Row="0" Source="/Images/roblox.jpg" Stretch="UniformToFill"/>
                                    <Border Grid.Row="1" Background="#1E293B" Padding="8,4">
                                        <TextBlock Text="Roblox" Foreground="#F8FAFC" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                </Grid>
                            </Border>

                        </WrapPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>